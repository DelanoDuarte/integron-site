---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Integron — Conformidade Fiscal para o Brasil Moderno',
  description = 'Detecte riscos em NF-e antes da transmissão. Validação automática de NCM, CFOP, GTIN e regras IBS/CBS para empresas que não podem errar.',
} = Astro.props

// Build format is "file" (privacy.html), so normalise the pathname to the
// clean, slash-free form the sitemap uses: "/" and "/privacy".
const cleanPath =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/\/$/, '') || '/'
const canonicalURL = new URL(cleanPath, Astro.site).href
const ogImage = new URL('/brand/integron-logo@2x.png', Astro.site).href
const siteName = 'Integron'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: siteName,
      url: Astro.site?.href,
      logo: new URL('/brand/integron-logo@2x.png', Astro.site).href,
      email: 'contato@integronhub.com.br',
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: Astro.site?.href,
      name: siteName,
      inLanguage: 'pt-BR',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
    {
      '@type': 'SoftwareApplication',
      name: siteName,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'pt-BR',
      description:
        'Plataforma de conformidade fiscal para NF-e: validação automática de NCM, CFOP, GTIN e regras IBS/CBS.',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
  ],
}
---
<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicons & PWA -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#10241A" media="(prefers-color-scheme: dark)" />

  <!-- Dark mode: runs before paint to avoid FOUC -->
  <script src="/js/theme.js" is:inline></script>

  <!-- Fonts: Latin-only, no italic (unused), loaded non-render-blocking with display=swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" />
  </noscript>

  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="CDTts69aoi_DsC5gzW-UGfhXRrb1taCGedohOuDwVyg" />

  <!-- OG / Social -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Structured data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <!-- GTM: initialise dataLayer, load script only after cookie consent -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function loadGTM() {
      if (window._gtmLoaded) return;
      window._gtmLoaded = true;
      (function(w,d,s,l,i){
        w[l]=w[l]||[];
        w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s);
        j.async=true;
        j.src='https://www.googletagmanager.com/gtm.js?id='+i;
        f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KXFR5SZP');
    }
    if (localStorage.getItem('integron_cookie_consent') === 'accepted') {
      loadGTM();
    }
    window._loadGTM = loadGTM;
  </script>
</head>
<body class="bg-white font-sans text-brand-ink antialiased dark:bg-brand-ink dark:text-white">
  <slot />

  <!-- ── Cookie consent banner ─────────────────────────────────────────── -->
  <div
    id="cookie-banner"
    role="dialog"
    aria-label="Aviso de cookies"
    aria-live="polite"
    class="fixed bottom-0 inset-x-0 z-50 hidden border-t border-white/10 bg-brand-ink px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-2xl dark:border-white/5 sm:px-6"
  >
    <div class="mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-slate-300">
        Usamos cookies para analytics e melhoria do produto.
        Ao aceitar, você concorda com nossa
        <a href="/privacy" class="underline hover:text-white transition-colors">Política de Privacidade</a>.
        Você pode rejeitar cookies não essenciais sem prejuízo ao acesso.
      </p>
      <div class="grid shrink-0 grid-cols-2 gap-2 sm:flex">
        <button
          id="cookie-reject"
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/20 px-4 py-2 text-sm font-semibold text-slate-300 hover:border-white/40 hover:text-white transition-colors"
        >
          Apenas essenciais
        </button>
        <button
          id="cookie-accept"
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-400 transition-colors"
        >
          Aceitar cookies
        </button>
      </div>
    </div>
  </div>

  <script>
    const KEY = 'integron_cookie_consent'
    const banner = document.getElementById('cookie-banner')

    function hideBanner() {
      if (banner) {
        banner.style.transform = 'translateY(100%)'
        banner.style.transition = 'transform 0.3s ease-in'
        setTimeout(() => banner.style.display = 'none', 320)
      }
    }

    function setConsent(value: string) {
      localStorage.setItem(KEY, value);
      (window as any).cookieConsent = value
      if (value === 'accepted') (window as any)._loadGTM?.()
      hideBanner()
    }

    // Show banner if no preference stored yet
    if (!localStorage.getItem(KEY)) {
      if (banner) {
        banner.style.display = 'block'
        // Slight delay so it doesn't flash immediately on load
        requestAnimationFrame(() => {
          setTimeout(() => {
            if (banner) {
              banner.style.transform = 'translateY(0)'
              banner.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)'
            }
          }, 800)
        })
        // Start hidden below viewport, then slide up
        banner.style.transform = 'translateY(100%)'
      }
    } else {
      (window as any).cookieConsent = localStorage.getItem(KEY)
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => setConsent('accepted'))
    document.getElementById('cookie-reject')?.addEventListener('click', () => setConsent('rejected'))
  </script>
</body>
</html>
