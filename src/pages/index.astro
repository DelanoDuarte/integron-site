        <div id="demo-video" class="relative aspect-video w-full bg-brand-900" data-video-id="1247038242">
          <button
            id="demo-video-play"
            type="button"
            aria-label="Reproduzir vídeo de demonstração do Integron"
            class="group absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-4 bg-gradient-to-br from-brand-800 to-brand-ink"
          >
            <span class="flex size-16 items-center justify-center rounded-full bg-white/95 shadow-lg transition-transform group-hover:scale-105">
              <svg class="ml-1 size-7 text-brand-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span class="text-sm font-semibold text-white">Ver demonstração</span>
          </button>
        </div>
      </div>
      <script>
        ;(function () {
          const holder = document.getElementById('demo-video')
          const btn = document.getElementById('demo-video-play')
          if (!holder || !btn) return
          const id = holder.dataset.videoId

          function loadIframe(autoplay: boolean) {
            const params = autoplay
              ? 'autoplay=1&muted=1&loop=1&autopause=0'
              : 'autoplay=1&autopause=0'
            const iframe = document.createElement('iframe')
            iframe.src = `https://player.vimeo.com/video/${id}?${params}&player_id=0&app_id=58479`
            iframe.className = 'absolute inset-0 h-full w-full'
            iframe.setAttribute('frameborder', '0')
            iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share')
            iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin')
            iframe.title = 'Integron Demo'
            holder.replaceChildren(iframe)
          }

          btn.addEventListener('click', () => loadIframe(false))

          // Autoplay only from md up and when reduced motion is not requested (V-02, PA-07)
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
          const desktop = window.matchMedia('(min-width: 768px)').matches
          if (desktop && !reduced) loadIframe(true)
        })()
      </script>

