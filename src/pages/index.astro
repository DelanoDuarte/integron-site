        const form = document.getElementById('contact-form') as HTMLFormElement
        const btn  = document.getElementById('contact-submit') as HTMLButtonElement
        const result = document.getElementById('contact-result') as HTMLElement

        form.addEventListener('submit', async (e) => {
          e.preventDefault()
          btn.disabled = true
          btn.textContent = 'Enviando…'
          result.className = 'mt-3 text-sm'

          const res  = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) })
          const data = await res.json()

          if (data.success) {
            result.textContent = '✓ Recebemos seu contato! Retornamos em até 1 dia útil.'
            result.classList.add('text-brand-300')
            form.reset()
            btn.textContent = 'Enviado'
          } else {
            result.textContent = data.message ?? 'Algo deu errado. Tente novamente.'
            result.classList.add('text-red-400')
            btn.disabled = false
            btn.textContent = 'Solicitar diagnóstico'
          }
        })
      </script>
    </div>
  </section>

