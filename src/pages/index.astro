      <img src="/brand/integron-logo.svg" alt="Integron" class="h-7 w-auto dark:hidden" />
      <img src="/brand/integron-logo-dark.svg" alt="Integron" class="hidden h-7 w-auto dark:block" />
      <p class="text-xs text-slate-400 dark:text-slate-500">
        © {new Date().getFullYear()} Integron. Todos os direitos reservados.
      </p>
      <nav class="flex gap-6 text-xs text-slate-400 dark:text-slate-500">
        <a href="#o-problema" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">O Problema</a>
        <a href="#funcionalidades" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Funcionalidades</a>
        <a href="#precos" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Preços</a>
