---
import Base from '../layouts/Base.astro'
---
<Base>

  <!-- ── Nav ──────────────────────────────────────────────────────────── -->
  <header class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur-md dark:border-white/8 dark:bg-brand-ink/90">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 sm:py-4 lg:px-8">
      <a href="/" aria-label="Integron" class="inline-flex min-h-11 items-center">
        <img src="/brand/integron-logo.svg" alt="Integron" width="140" height="32" class="h-8 w-auto dark:hidden sm:h-9" />
        <img src="/brand/integron-logo-dark.svg" alt="Integron" width="140" height="32" class="hidden h-8 w-auto dark:block sm:h-9" />
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium text-slate-500 dark:text-slate-300 md:flex">
        <a href="#o-problema" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">O Problema</a>
        <a href="#funcionalidades" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Funcionalidades</a>
        <a href="#como-funciona" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Como funciona</a>
        <a href="#precos" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Preços</a>
      </nav>
      <div class="flex items-center gap-1.5 sm:gap-3">
        <button data-theme-toggle aria-label="Alternar tema"
          class="inline-flex size-11 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors">
          <svg class="hidden size-4.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="size-4.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href="#contato" class="hidden rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800 transition-colors md:inline-flex">
          Falar com vendas
        </a>
        <!-- Mobile CTA + menu toggle (H-03) -->
        <a href="#contato" class="inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-3.5 text-sm font-semibold text-white hover:bg-brand-800 transition-colors md:hidden">
          Contato
        </a>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex size-11 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/10 transition-colors md:hidden"
        >
          <svg id="menu-icon-open" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="menu-icon-close" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu panel (H-01, PA-06) -->
    <div id="mobile-menu" hidden class="border-t border-slate-100 bg-white dark:border-white/8 dark:bg-brand-ink md:hidden">
      <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2 text-base font-medium text-slate-600 dark:text-slate-200">
        <a href="#o-problema" class="menu-link flex min-h-11 items-center py-3 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">O Problema</a>
        <a href="#funcionalidades" class="menu-link flex min-h-11 items-center py-3 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Funcionalidades</a>
        <a href="#como-funciona" class="menu-link flex min-h-11 items-center py-3 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Como funciona</a>
        <a href="#precos" class="menu-link flex min-h-11 items-center py-3 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Preços</a>
        <a href="#contato" class="menu-link mt-2 mb-3 inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-700 px-4 py-3 font-semibold text-white hover:bg-brand-800 transition-colors">
          Falar com vendas
        </a>
      </nav>
    </div>
  </header>

  <!-- ── Mobile menu behaviour (H-01, PA-06) ───────────────────────────── -->
  <script>
    ;(function () {
      const toggle = document.getElementById('menu-toggle')
      const panel  = document.getElementById('mobile-menu')
      const iconOpen  = document.getElementById('menu-icon-open')
      const iconClose = document.getElementById('menu-icon-close')
      if (!toggle || !panel) return

      let lastFocus: HTMLElement | null = null

      function open() {
        if (!panel || !toggle) return
        lastFocus = document.activeElement as HTMLElement
        panel.hidden = false
        toggle.setAttribute('aria-expanded', 'true')
        toggle.setAttribute('aria-label', 'Fechar menu')
        iconOpen?.classList.add('hidden')
        iconClose?.classList.remove('hidden')
        const first = panel.querySelector<HTMLElement>('a, button')
        first?.focus()
      }

      function close(restore = true) {
        if (!panel || !toggle) return
        panel.hidden = true
        toggle.setAttribute('aria-expanded', 'false')
        toggle.setAttribute('aria-label', 'Abrir menu')
        iconClose?.classList.add('hidden')
        iconOpen?.classList.remove('hidden')
        if (restore) (lastFocus ?? toggle).focus()
      }

      toggle.addEventListener('click', () => {
        panel.hidden ? open() : close()
      })

      panel.querySelectorAll('.menu-link').forEach(link => {
        link.addEventListener('click', () => close(false))
      })

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !panel.hidden) close()
      })

      // Close when resizing up to the desktop breakpoint
      window.matchMedia('(min-width: 768px)').addEventListener('change', e => {
        if (e.matches && !panel.hidden) close(false)
      })
    })()
  </script>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-white dark:bg-brand-ink">
    <!-- Subtle radial gradient only -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,theme(colors.brand-100/50),transparent)] dark:bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,theme(colors.brand-900/40),transparent)]"></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-0 sm:px-6 sm:pt-20 lg:px-8">
      <!-- Centered copy -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="animate-fade-up">
          <span class="inline-flex max-w-full items-center gap-2 whitespace-normal rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-xs font-semibold text-brand-700 dark:border-brand-700 dark:bg-brand-900/50 dark:text-brand-300">
            <span class="size-1.5 shrink-0 rounded-full bg-brand-500 animate-pulse"></span>
            Validação pré-SEFAZ — IBS e CBS em roadmap
          </span>
        </div>
        <h1 class="mt-6 font-heading text-3xl font-bold leading-[1.1] tracking-tight text-balance text-brand-ink dark:text-white sm:text-5xl lg:text-6xl animate-fade-up" style="animation-delay: 80ms">
          Pare rejeições de NF&#8209;e<br/>
          <span class="text-gradient">antes que aconteçam</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-slate-500 dark:text-slate-400 sm:text-lg animate-fade-up" style="animation-delay: 160ms">
          Valide NCM, CFOP, GTIN e regras fiscais automaticamente antes de transmitir à SEFAZ — sem mudar de ERP, sem analistas em modo firefighting.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center animate-fade-up" style="animation-delay: 240ms">
          <a href="#contato" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-brand-700 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-900/20 hover:bg-brand-800 hover:-translate-y-px transition-all sm:w-auto">
            Solicitar diagnóstico gratuito
          </a>
          <a href="#como-funciona" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-white transition-all sm:w-auto">
            Como funciona →
          </a>
        </div>
      </div>

      <!-- Product mockup (centered, below CTAs) -->
      <div class="relative mt-14 animate-fade-up" style="animation-delay: 200ms">
        <div role="img" aria-label="Painel de validações de NF-e do Integron, mostrando notas aprovadas, em revisão e rejeitadas em tempo real" class="mx-auto max-w-4xl overflow-hidden rounded-xl border border-slate-200/80 shadow-2xl shadow-slate-900/10 dark:border-brand-700/40 dark:shadow-brand-900/40">
          <!-- Browser chrome -->
          <div aria-hidden="true" class="flex items-center gap-3 border-b border-slate-200/60 bg-slate-50 px-4 py-2.5 dark:border-brand-700/40 dark:bg-brand-900">
            <div class="flex gap-1.5">
              <span class="size-2.5 rounded-full bg-red-400/70"></span>
              <span class="size-2.5 rounded-full bg-amber-400/70"></span>
              <span class="size-2.5 rounded-full bg-green-400/70"></span>
            </div>
            <div class="min-w-0 flex-1 truncate rounded bg-white/70 px-3 py-1 font-mono text-[11px] text-slate-400 dark:bg-brand-800/60 dark:text-slate-500">
              app.integronhub.com.br/validacoes
            </div>
            <div class="flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-green-500"></span>
              <span class="text-[10px] text-slate-400 dark:text-slate-500">Online</span>
            </div>
          </div>
          <!-- App shell -->
          <div aria-hidden="true" class="flex h-[360px] sm:h-[400px]">
            <!-- Sidebar (hidden on phones) -->
            <div class="hidden w-14 shrink-0 flex-col items-center gap-3.5 bg-brand-800 pb-4 pt-4 dark:bg-brand-900 sm:flex">
              <img src="/brand/integron-mark-dark.svg" alt="" class="mb-2 h-6 w-auto" />
              <div class="flex size-8 items-center justify-center rounded-lg bg-brand-700">
                <img src="/icons/list-checks.svg" alt="" class="size-4 invert opacity-90" />
              </div>
              <img src="/icons/layout-dashboard.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/receipt-text.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/bell-ring.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/chart-column.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/settings.svg" alt="" class="mt-auto size-4 invert opacity-35" />
            </div>
            <!-- Main content -->
            <div class="flex min-w-0 flex-1 flex-col overflow-hidden bg-slate-50 dark:bg-brand-900/50">
              <!-- Top bar -->
              <div class="flex shrink-0 items-center justify-between border-b border-slate-100 bg-white px-5 py-3 dark:border-brand-700/40 dark:bg-brand-800/80">
                <div>
                  <p class="text-xs font-semibold text-slate-800 dark:text-white">Validações em tempo real</p>
                  <p class="text-[9px] text-slate-400">Hoje · atualizado há 2 min</p>
                </div>
                <div class="flex gap-2">
                  <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[10px] font-medium text-slate-500 dark:border-brand-700 dark:bg-brand-800 dark:text-slate-400">Exportar</span>
                  <span class="rounded-full bg-brand-700 px-2.5 py-1 text-[10px] font-medium text-white">+ Nova validação</span>
                </div>
              </div>
              <!-- Stats row -->
              <div class="grid shrink-0 grid-cols-3 gap-3 p-4">
                <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-brand-700/40 dark:bg-brand-800/60">
                  <p class="text-[9px] font-medium uppercase tracking-wider text-slate-400">Validadas hoje</p>
                  <p class="mt-1 font-heading text-xl font-bold text-brand-700 dark:text-brand-300">142</p>
                </div>
                <div class="rounded-lg border border-amber-100 bg-white p-3 dark:border-amber-900/30 dark:bg-brand-800/60">
                  <p class="text-[9px] font-medium uppercase tracking-wider text-slate-400">Alertas</p>
                  <p class="mt-1 font-heading text-xl font-bold text-amber-500 dark:text-amber-400">9</p>
                </div>
                <div class="rounded-lg border border-red-100 bg-white p-3 dark:border-red-900/30 dark:bg-brand-800/60">
                  <p class="text-[9px] font-medium uppercase tracking-wider text-slate-400">Críticas</p>
                  <p class="mt-1 font-heading text-xl font-bold text-red-600 dark:text-red-400">3</p>
                </div>
              </div>
              <!-- Table header -->
              <div class="mx-4 mb-2 grid grid-cols-[2fr_1fr_80px] gap-2 px-3">
                <span class="text-[9px] font-semibold uppercase tracking-wider text-slate-400">NF-e / Chave</span>
                <span class="text-[9px] font-semibold uppercase tracking-wider text-slate-400">Achados</span>
                <span class="text-[9px] font-semibold uppercase tracking-wider text-slate-400">Status</span>
              </div>
              <!-- NF-e rows -->
              <div id="nfe-feed" class="space-y-1.5 overflow-hidden px-4">
                <div class="grid grid-cols-[2fr_1fr_80px] items-center gap-2 rounded-lg border border-red-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.red.500)] dark:border-red-900/30 dark:bg-brand-800/60">
                  <div>
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.172</p>
                    <p class="text-[9px] text-slate-400">NCM 7318.15.00 · CFOP 6102</p>
                  </div>
                  <span class="text-[10px] font-medium text-red-500">2 erros</span>
                  <span class="rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[9px] font-semibold text-red-600 dark:border-red-800 dark:bg-red-900/40">Rejeição</span>
                </div>
                <div class="grid grid-cols-[2fr_1fr_80px] items-center gap-2 rounded-lg border border-amber-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.amber.400)] dark:border-amber-900/30 dark:bg-brand-800/60">
                  <div>
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.173</p>
                    <p class="text-[9px] text-slate-400">IBS ausente · GTIN ok</p>
                  </div>
                  <span class="text-[10px] font-medium text-amber-500">1 alerta</span>
                  <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[9px] font-semibold text-amber-700 dark:border-amber-800 dark:bg-amber-900/40">Revisão</span>
                </div>
                <div class="grid grid-cols-[2fr_1fr_80px] items-center gap-2 rounded-lg border border-slate-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.brand-500)] dark:border-brand-700/30 dark:bg-brand-800/60">
                  <div>
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.174</p>
                    <p class="text-[9px] text-slate-400">NCM · CFOP · XSD ok</p>
                  </div>
                  <span class="text-[10px] font-medium text-brand-500">0 erros</span>
                  <span class="rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-[9px] font-semibold text-brand-700 dark:border-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Aprovada</span>
                </div>
                <div class="grid grid-cols-[2fr_1fr_80px] items-center gap-2 rounded-lg border border-slate-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.brand-500)] dark:border-brand-700/30 dark:bg-brand-800/60">
                  <div>
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.175</p>
                    <p class="text-[9px] text-slate-400">CSOSN verificado · GTIN ok</p>
                  </div>
                  <span class="text-[10px] font-medium text-brand-500">0 erros</span>
                  <span class="rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-[9px] font-semibold text-brand-700 dark:border-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Aprovada</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Fade mockup into next section -->
        <div aria-hidden="true" class="pointer-events-none absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-white to-transparent dark:from-brand-ink"></div>
      </div>
    </div>
  </section>

  <!-- ── Integrations strip ──────────────────────────────────────────────── -->
  <section class="border-b border-slate-100 bg-white px-4 py-12 dark:border-white/5 dark:bg-brand-ink sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="mb-8 text-center text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 reveal">
        Integra com os principais ERPs do mercado brasileiro
      </p>
      <div class="flex flex-wrap justify-center gap-3 reveal" style="--delay: 80ms">
        {[
          { name: 'TOTVS Protheus',  note: 'v12 · REST & SFTP' },
          { name: 'SAP S/4HANA',     note: 'OData & SFTP'      },
          { name: 'Oracle EBS',      note: 'REST API'           },
          { name: 'Sankhya',         note: 'SDK REST'           },
          { name: 'Senior Sistemas', note: 'REST API'           },
        ].map(e => (
          <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-5 py-3.5 shadow-sm transition-shadow hover:shadow-md dark:border-brand-700/40 dark:bg-brand-800/60">
            <span class="size-2 shrink-0 rounded-full bg-brand-500"></span>
            <div>
              <p class="font-heading text-sm font-semibold text-slate-800 dark:text-slate-100">{e.name}</p>
              <p class="text-[10px] text-slate-400 dark:text-slate-500">{e.note}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-500 reveal" style="--delay: 160ms">
        Integração via API REST ou monitor SFTP — sem instalar agente no servidor do ERP
      </p>
    </div>
  </section>

  <!-- ── Stats strip ───────────────────────────────────────────────────── -->
  <section class="border-y border-slate-100 bg-slate-50 px-4 py-12 dark:border-white/5 dark:bg-white/3 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 divide-y divide-slate-200/70 sm:grid-cols-3 sm:gap-10 sm:divide-y-0 dark:divide-white/10">
      <div class="pt-6 text-center reveal sm:pt-0">
        <p class="font-heading text-4xl font-bold text-brand-700 dark:text-brand-400 whitespace-nowrap">&lt; 1 s</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">resposta da API de validação pré-SEFAZ</p>
      </div>
      <div class="pt-6 text-center reveal sm:pt-0" style="--delay: 100ms">
        <p class="font-heading text-4xl font-bold text-brand-700 dark:text-brand-400 whitespace-nowrap">1–3 h</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">de analista fiscal para corrigir cada rejeição manualmente</p>
      </div>
      <div class="pt-6 text-center reveal sm:pt-0" style="--delay: 200ms">
        <p class="font-heading text-4xl font-bold text-brand-700 dark:text-brand-400 whitespace-nowrap">R$ 200 mil</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">de capital de giro bloqueado em 48 h para quem fatura R$ 10 M/mês</p>
      </div>
    </div>
  </section>

  <!-- ── Pain points ───────────────────────────────────────────────────── -->
  <section id="o-problema" class="scroll-mt-20 bg-white px-4 py-12 dark:bg-brand-ink sm:px-6 sm:py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="text-center reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">O problema</p>
        <h2 class="mt-3 font-heading text-2xl font-bold tracking-tight text-brand-ink dark:text-white sm:text-3xl lg:text-4xl">
          O custo real de uma NF-e rejeitada
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-slate-500 dark:text-slate-400">
          A maioria das empresas só conta a multa. O prejuízo real é três vezes maior — e quase sempre invisível no balanço.
        </p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-3">

        <!-- 01 · Multas -->
        <div class="reveal group rounded-2xl border border-slate-200 bg-white p-5 card-glow transition-all hover:-translate-y-0.5 sm:p-7 dark:border-brand-700/30 dark:bg-brand-ink" style="--delay: 50ms">
          <div class="flex items-start justify-between gap-2">
            <span class="select-none font-heading text-4xl font-bold leading-none sm:text-6xl text-red-100 dark:text-red-900/50">01</span>
            <span class="mt-1 shrink-0 rounded-full border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-600 dark:border-red-800/50 dark:bg-red-950/40 dark:text-red-400">Risco fiscal</span>
          </div>
          <h3 class="mt-4 font-heading text-lg font-bold text-brand-ink dark:text-white">Multas do Fisco</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            Uma NF-e rejeitada inicia um relógio legal. Sem reemissão dentro do prazo, a operação fica sem cobertura fiscal — e as penalidades chegam automaticamente.
          </p>
          <div class="mt-5 border-t border-slate-100 pt-5 dark:border-brand-700/30">
            <p class="text-sm text-slate-700 dark:text-slate-300">Operações sem NF-e autorizada ficam sem cobertura fiscal e sujeitas a penalidades sobre o valor da operação — o impacto exato varia por estado e atividade.</p>
          </div>
          <p class="mt-4 text-xs text-slate-400 dark:text-slate-500">
            A Reforma Tributária adicionará novos campos obrigatórios. Acompanhamos a regulamentação.
          </p>
        </div>

        <!-- 02 · Retrabalho -->
        <div class="reveal group rounded-2xl border border-slate-200 bg-white p-5 card-glow transition-all hover:-translate-y-0.5 sm:p-7 dark:border-brand-700/30 dark:bg-brand-ink" style="--delay: 150ms">
          <div class="flex items-start justify-between gap-2">
