---
import Base from '../layouts/Base.astro'
---
<Base>

  <!-- ── Nav ──────────────────────────────────────────────────────────── -->
  <header class="sticky top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-md dark:border-white/8 dark:bg-brand-ink/90">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" aria-label="Integron">
        <img src="/brand/integron-logo.svg" alt="Integron" class="h-8 w-auto dark:hidden" />
        <img src="/brand/integron-logo-dark.svg" alt="Integron" class="hidden h-8 w-auto dark:block" />
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium text-slate-500 dark:text-slate-300 md:flex">
        <a href="#o-problema" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">O Problema</a>
        <a href="#funcionalidades" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Funcionalidades</a>
        <a href="#como-funciona" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Como funciona</a>
        <a href="#precos" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Preços</a>
      </nav>
      <div class="flex items-center gap-3">
        <button data-theme-toggle aria-label="Alternar tema"
          class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors">
          <svg class="hidden size-4.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="size-4.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <a href="#contato"
          class="rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800 transition-colors">
          Falar com vendas
        </a>
      </div>
    </div>
  </header>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-white dark:bg-brand-ink">
    <!-- Dot grid + ambient blobs -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 dot-grid opacity-60"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute right-0 top-0 h-[560px] w-[560px] translate-x-1/3 -translate-y-1/3 rounded-full bg-brand-100/60 blur-3xl dark:bg-brand-900/50"></div>
      <div class="absolute bottom-0 left-1/4 h-[380px] w-[380px] translate-y-1/2 rounded-full bg-brand-50 blur-3xl dark:bg-brand-900/30"></div>
      <div class="absolute left-0 top-1/2 h-[300px] w-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-100/40 blur-3xl dark:bg-brand-800/20"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 py-20 lg:flex lg:items-center lg:gap-14 lg:py-28">

      <!-- Left: copy -->
      <div class="lg:w-[52%]">
        <div class="animate-fade-up" style="animation-delay: 0ms">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-xs font-semibold text-brand-700 dark:border-brand-700 dark:bg-brand-900/50 dark:text-brand-300">
            <span class="size-1.5 rounded-full bg-brand-500 animate-pulse"></span>
            Preparado para IBS e CBS — Reforma Tributária 2026
          </span>
        </div>
        <h1 class="mt-6 font-heading text-4xl font-bold leading-[1.1] tracking-tight text-brand-ink dark:text-white md:text-5xl lg:text-[3.2rem] animate-fade-up" style="animation-delay: 80ms">
          Uma NF-e rejeitada não é<br class="hidden sm:block" /> só um erro.
          <span class="text-gradient"> É dinheiro parado.</span>
        </h1>
        <p class="mt-6 max-w-lg text-base leading-relaxed text-slate-500 dark:text-slate-400 animate-fade-up" style="animation-delay: 160ms">
          Caminhão parado na doca. Capital de giro bloqueado. Multa de até 100% do valor da operação.
          O Integron valida NCM, CFOP, GTIN, IBS e CBS <strong class="font-semibold text-brand-ink dark:text-white">antes</strong> de você transmitir à SEFAZ — para que nenhum desses problemas aconteça.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 animate-fade-up" style="animation-delay: 240ms">
          <a href="#contato"
            class="rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-900/25 hover:bg-brand-800 hover:-translate-y-px transition-all">
            Solicitar diagnóstico gratuito
          </a>
          <a href="#o-problema"
            class="rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-700 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:border-brand-500 transition-all">
            Ver o custo real →
          </a>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 animate-fade-up" style="animation-delay: 320ms">
          <p class="text-xs font-medium text-slate-400 dark:text-slate-500">Integra com:</p>
          {['TOTVS Protheus', 'SAP S/4HANA', 'Oracle EBS', 'Sankhya', 'Senior'].map(erp => (
            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">{erp}</span>
          ))}
        </div>
      </div>

      <!-- Right: app mockup -->
      <div class="relative mt-14 lg:mt-0 lg:w-[48%] animate-fade-up" style="animation-delay: 200ms">
        <div class="rounded-xl overflow-hidden border border-slate-200/80 shadow-2xl shadow-brand-900/15 dark:border-brand-700/40 dark:shadow-brand-900/50">
          <!-- Browser chrome -->
          <div class="flex items-center gap-3 border-b border-slate-200/80 bg-brand-50 px-4 py-2.5 dark:border-brand-700/40 dark:bg-brand-900">
            <div class="flex gap-1.5">
              <span class="size-2.5 rounded-full bg-red-400/70"></span>
              <span class="size-2.5 rounded-full bg-amber-400/70"></span>
              <span class="size-2.5 rounded-full bg-green-400/70"></span>
            </div>
            <div class="flex-1 rounded bg-white/60 px-3 py-1 font-mono text-[11px] text-slate-400 dark:bg-brand-800/60 dark:text-slate-500">
              app.integron.com.br/validacoes
            </div>
          </div>
          <!-- App shell -->
          <div class="flex" style="height: 390px">
            <!-- Sidebar -->
            <div class="flex w-14 shrink-0 flex-col items-center gap-3.5 bg-brand-800 pb-4 pt-4 dark:bg-brand-900">
              <img src="/brand/integron-mark-dark.svg" alt="" class="mb-2 h-6 w-auto" />
              <div class="flex size-8 items-center justify-center rounded-lg bg-brand-700">
                <img src="/icons/list-checks.svg" alt="" class="size-4 invert opacity-90" />
              </div>
              <img src="/icons/layout-dashboard.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/receipt-text.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/bell-ring.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/chart-column.svg" alt="" class="size-4 invert opacity-35" />
              <img src="/icons/settings.svg" alt="" class="mt-auto size-4 invert opacity-35" />
            </div>
            <!-- Main area -->
            <div class="flex flex-1 flex-col overflow-hidden bg-brand-50 dark:bg-brand-900/50">
              <!-- Top bar -->
              <div class="flex shrink-0 items-center justify-between border-b border-brand-100 bg-white px-4 py-2.5 dark:border-brand-700/40 dark:bg-brand-800/80">
                <div>
                  <p class="text-[11px] font-semibold text-brand-900 dark:text-white">Validações em tempo real</p>
                  <p class="text-[9px] text-slate-400 dark:text-slate-500">Hoje · atualizado há 2 min</p>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="size-1.5 rounded-full bg-green-500"></span>
                  <span class="text-[9px] text-slate-500 dark:text-slate-400">Online</span>
                </div>
              </div>
              <!-- Stats -->
              <div class="grid shrink-0 grid-cols-3 gap-2 p-3">
                <div class="rounded-lg border border-brand-100 bg-white p-2.5 text-center dark:border-brand-700/40 dark:bg-brand-800/60">
                  <p class="text-[8.5px] font-medium uppercase tracking-wider text-slate-400">Validadas</p>
                  <p class="mt-0.5 text-base font-bold text-brand-700 dark:text-brand-300">142</p>
                </div>
                <div class="rounded-lg border border-amber-100 bg-white p-2.5 text-center dark:border-amber-900/30 dark:bg-brand-800/60">
                  <p class="text-[8.5px] font-medium uppercase tracking-wider text-slate-400">Alertas</p>
                  <p class="mt-0.5 text-base font-bold text-amber-600 dark:text-amber-400">9</p>
                </div>
                <div class="rounded-lg border border-red-100 bg-white p-2.5 text-center dark:border-red-900/30 dark:bg-brand-800/60">
                  <p class="text-[8.5px] font-medium uppercase tracking-wider text-slate-400">Críticas</p>
                  <p class="mt-0.5 text-base font-bold text-red-600 dark:text-red-400">3</p>
                </div>
              </div>
              <!-- NF-e list -->
              <div class="space-y-1.5 overflow-hidden px-3">
                <div class="flex items-center gap-2 rounded-lg border border-red-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.red.500)] dark:border-red-900/30 dark:bg-brand-800/60">
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.172</p>
                    <p class="text-[9px] text-slate-400">NCM 7318.15.00 · CFOP 6102</p>
                  </div>
                  <span class="shrink-0 rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[9px] font-semibold text-red-600 dark:border-red-800 dark:bg-red-900/40">Rejeição</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg border border-amber-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.amber.400)] dark:border-amber-900/30 dark:bg-brand-800/60">
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.173</p>
                    <p class="text-[9px] text-slate-400">IBS ausente · GTIN ok</p>
                  </div>
                  <span class="shrink-0 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[9px] font-semibold text-amber-700 dark:border-amber-800 dark:bg-amber-900/40">Revisão</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg border border-brand-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.brand-500)] dark:border-brand-700/30 dark:bg-brand-800/60">
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.174</p>
                    <p class="text-[9px] text-slate-400">NCM · CFOP · IBS/CBS ok</p>
                  </div>
                  <span class="shrink-0 rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-[9px] font-semibold text-brand-700 dark:border-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Aprovada</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg border border-brand-100 bg-white px-3 py-2.5 [border-left:2px_solid_theme(colors.brand-500)] dark:border-brand-700/30 dark:bg-brand-800/60">
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] font-semibold text-slate-800 dark:text-slate-200">NF-e 48.175</p>
                    <p class="text-[9px] text-slate-400">CBS calculado · GTIN verificado</p>
                  </div>
                  <span class="shrink-0 rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-[9px] font-semibold text-brand-700 dark:border-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Aprovada</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-5 -left-5 hidden rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-xl lg:flex items-center gap-3 dark:border-brand-700 dark:bg-brand-800">
          <div class="flex size-9 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
            <svg class="size-4.5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-brand-ink dark:text-white">NF-e aprovada</p>
            <p class="text-[10px] text-slate-400">Sem erros · 42 ms</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats strip ───────────────────────────────────────────────────── -->
  <section class="bg-brand-800 px-6 py-16 dark:bg-brand-900">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 sm:grid-cols-3">
      <div class="text-center reveal">
        <p class="font-heading text-4xl font-bold text-white">até 100%</p>
        <p class="mt-2 text-sm leading-relaxed text-brand-300">do valor da operação em multa por NF-e sem cobertura fiscal</p>
      </div>
      <div class="text-center reveal" style="--delay: 100ms">
        <p class="font-heading text-4xl font-bold text-white">1–3 h</p>
        <p class="mt-2 text-sm leading-relaxed text-brand-300">de analista fiscal para corrigir cada rejeição manualmente</p>
      </div>
      <div class="text-center reveal" style="--delay: 200ms">
        <p class="font-heading text-4xl font-bold text-white">R$ 200 mil</p>
        <p class="mt-2 text-sm leading-relaxed text-brand-300">de capital de giro bloqueado em 48 h para quem fatura R$ 10 M/mês</p>
      </div>
    </div>
  </section>

  <!-- ── Pain points ───────────────────────────────────────────────────── -->
  <section id="o-problema" class="px-6 py-24 bg-white dark:bg-brand-ink">
    <div class="mx-auto max-w-6xl">
      <div class="text-center reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">O problema</p>
        <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-brand-ink dark:text-white md:text-4xl">
          O custo real de uma NF-e rejeitada
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-slate-500 dark:text-slate-400">
          A maioria das empresas só conta a multa. O prejuízo real é três vezes maior — e quase sempre invisível no balanço.
        </p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-3">

        <!-- 01 · Multas -->
        <div class="reveal group rounded-2xl border border-slate-200 bg-white p-7 card-glow transition-all hover:-translate-y-0.5 dark:border-brand-700/30 dark:bg-brand-ink" style="--delay: 50ms">
          <div class="flex items-start justify-between gap-2">
            <span class="select-none font-heading text-6xl font-bold leading-none text-red-100 dark:text-red-900/50">01</span>
            <span class="mt-1 shrink-0 rounded-full border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-600 dark:border-red-800/50 dark:bg-red-950/40 dark:text-red-400">Risco fiscal</span>
          </div>
          <h3 class="mt-4 font-heading text-lg font-bold text-brand-ink dark:text-white">Multas do Fisco</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            Uma NF-e rejeitada inicia um relógio legal. Sem reemissão dentro do prazo, a operação fica sem cobertura fiscal — e as penalidades chegam automaticamente.
          </p>
          <div class="mt-5 border-t border-slate-100 pt-5 dark:border-brand-700/30">
            <p class="text-xs font-medium text-slate-400 dark:text-slate-500">São Paulo · Art. 527 RICMS/SP</p>
            <p class="mt-1.5 text-sm text-slate-700 dark:text-slate-300">R$ 80k em mercadorias → multa de <span class="font-semibold text-red-600 dark:text-red-400">R$ 40.000</span></p>
            <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">Penalidade geral: <span class="font-semibold text-red-500">10 %–100 %</span> do valor da operação.</p>
          </div>
          <p class="mt-4 text-xs text-slate-400 dark:text-slate-500">
            Campos IBS/CBS obrigatórios a partir de ago/2026 adicionam novos gatilhos de rejeição.
          </p>
        </div>

        <!-- 02 · Retrabalho -->
        <div class="reveal group rounded-2xl border border-slate-200 bg-white p-7 card-glow transition-all hover:-translate-y-0.5 dark:border-brand-700/30 dark:bg-brand-ink" style="--delay: 150ms">
          <div class="flex items-start justify-between gap-2">
            <span class="select-none font-heading text-6xl font-bold leading-none text-amber-100 dark:text-amber-900/50">02</span>
            <span class="mt-1 shrink-0 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:border-amber-800/50 dark:bg-amber-950/40 dark:text-amber-400">Produtividade</span>
          </div>
          <h3 class="mt-4 font-heading text-lg font-bold text-brand-ink dark:text-white">Retrabalho operacional</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            Cada rejeição força um ciclo manual de quatro etapas, repetido centenas de vezes por semana.
          </p>
          <div class="mt-5 space-y-2.5">
            {[
              'Identificar o código SEFAZ (série 500)',
              'Localizar a nota no ERP',
              'Corrigir em ERP + tabela fiscal',
              'Reenviar e confirmar autorização',
            ].map((s, i) => (
              <div class="flex items-center gap-3">
                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-amber-100 text-[10px] font-bold text-amber-700 dark:bg-amber-900/40 dark:text-amber-400">{i + 1}</span>
                <span class="text-xs text-slate-500 dark:text-slate-400">{s}</span>
              </div>
            ))}
          </div>
          <div class="mt-5 border-t border-slate-100 pt-5 dark:border-brand-700/30">
            <p class="text-sm text-slate-700 dark:text-slate-300">
              <span class="font-semibold text-amber-600 dark:text-amber-400">1–3 h</span> por rejeição ·
              com 50/dia chegam a <span class="font-semibold text-amber-600 dark:text-amber-400">150 h de firefighting</span>
            </p>
          </div>
        </div>

        <!-- 03 · Cascata -->
        <div class="reveal group rounded-2xl border border-slate-200 bg-white p-7 card-glow transition-all hover:-translate-y-0.5 dark:border-brand-700/30 dark:bg-brand-ink" style="--delay: 250ms">
          <div class="flex items-start justify-between gap-2">
            <span class="select-none font-heading text-6xl font-bold leading-none text-orange-100 dark:text-orange-900/50">03</span>
            <span class="mt-1 shrink-0 rounded-full border border-orange-200 bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700 dark:border-orange-800/50 dark:bg-orange-950/40 dark:text-orange-400">Impacto em cascata</span>
          </div>
          <h3 class="mt-4 font-heading text-lg font-bold text-brand-ink dark:text-white">A cascata que ninguém conta</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            O maior prejuízo raramente é a multa. É a parada que se propaga por toda a operação.
          </p>
          <div class="mt-5 space-y-3.5">
            {[
              { label: 'Caminhão parado na doca', detail: 'Frete, hora extra do motorista e SLA de entrega perdido.' },
              { label: 'Capital de giro bloqueado', detail: '2% de notas paradas por 48 h bloqueiam R$ 200 mil para quem fatura R$ 10 M/mês.' },
              { label: 'Créditos IBS/CBS perdidos', detail: 'Fornecedores com má higiene fiscal perdem clientes primeiro informalmente, depois contratualmente.' },
            ].map(({ label, detail }) => (
              <div class="flex gap-3">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-orange-400"></span>
                <div>
                  <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">{label}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-slate-400 dark:text-slate-500">{detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Bridge -->
      <div class="mt-14 reveal rounded-2xl bg-brand-700 p-8 text-center text-white md:p-12">
        <h3 class="font-heading text-2xl font-bold md:text-3xl">O Integron resolve as três camadas</h3>
        <p class="mx-auto mt-4 max-w-2xl text-brand-200">
          Validação antes da transmissão elimina as multas. O relatório de diagnóstico reduz o retrabalho de horas para minutos.
          Monitoramento em tempo real interrompe a cascata operacional em até 5 minutos da emissão.
        </p>
        <a href="#funcionalidades"
          class="mt-8 inline-block rounded-lg bg-white px-6 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50 transition-colors">
          Ver como funciona →
        </a>
      </div>
    </div>
  </section>

  <!-- ── Features ─────────────────────────────────────────────────────── -->
  <section id="funcionalidades" class="bg-brand-50 px-6 py-24 dark:bg-white/5">
    <div class="mx-auto max-w-6xl">
      <div class="text-center reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">Funcionalidades</p>
        <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-brand-ink dark:text-white md:text-4xl">
          Tudo que sua equipe fiscal precisa
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-slate-500 dark:text-slate-400">
          Um hub centralizado para diagnóstico, alertas e conformidade — sem trocar de sistema.
        </p>
      </div>
      <!-- Bento grid -->
      <div class="mt-14 grid gap-4 lg:grid-cols-3 lg:grid-rows-[auto_auto]">

        <!-- Wide card: Validação pré-SEFAZ -->
        <div class="reveal group lg:col-span-2 rounded-2xl border border-slate-100 bg-white p-8 card-glow transition-all hover:-translate-y-0.5 dark:border-brand-700/30 dark:bg-brand-ink">
          <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 transition-colors group-hover:bg-brand-100 dark:bg-brand-900/40">
